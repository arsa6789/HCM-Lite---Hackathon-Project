# MongoDB connection string (MongoDB Atlas free M0 tier works great)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hackathon?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Long random string used to sign JWTs.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_secret_here
