NODE_ENV=development
PORT=4000
# Comma-separated exact origins; add the deployed frontend URL with no trailing slash.
CORS_ORIGINS=http://localhost:3000,https://hcm-lite-project-new.vercel.app
FIREBASE_PROJECT_ID=hmc-lite
# Optional for named Firestore databases; leave empty for (default).
FIREBASE_DATABASE_ID=
# Use either local Application Default Credentials or the service-account path below.
# On Google Cloud, prefer the runtime service account/workload identity.
# Example for a replacement key stored locally at server/service-account.json:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
# For Vercel, add the rotated service-account JSON as a server-only Environment Variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Or use base64-encoded JSON if your deployment environment alters newlines.
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional: set to 127.0.0.1:8080 when using the Firestore emulator.
FIRESTORE_EMULATOR_HOST=
# UID of a Firebase Auth user; seed grants this account the admin claim.
SEED_ADMIN_UID=
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
