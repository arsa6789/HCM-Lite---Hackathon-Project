NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
MONGODB_URI_ONLINE=mongodb+srv://<username>:<password>@<cluster>/hcm_lite
JWT_SECRET=your_super_long_random_secret_here
JWT_EXPIRES_IN=7d
COOKIE_NAME=hcm_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=604800000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SEED_ADMIN_EMAIL=admin@hcm.local
SEED_ADMIN_PASSWORD=change_me_please
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
